FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d

LABEL org.opencontainers.image.title="ClawSweeper automerge E2E base"
LABEL org.opencontainers.image.source="https://github.com/openclaw/clawsweeper"

# Nested rootless builders may have a single UID/GID mapping. APT's default
# _apt privilege drop cannot be represented in that namespace, so prevent the
# failing setgroups/setegid transition. This affects only the disposable image
# build; the outer untrusted worker remains unprivileged and socket-isolated.
RUN apt-get -o APT::Sandbox::User=root update \
  && apt-get -o APT::Sandbox::User=root install --yes --no-install-recommends ca-certificates gh git python3 \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable
